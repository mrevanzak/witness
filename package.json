{
  "name": "witness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "image:build": "docker build -t witness-computer:dev infra/computer",
    "verify:smoke": "tsx packages/computer/scripts/smoke.ts",
    "witness": "tsx apps/cli/src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/renderer/remotion/tsconfig.json",
    "e2e:scripted": "tsx packages/orchestrator/scripts/scripted-e2e.ts",
    "acceptance:phase3": "tsx packages/orchestrator/scripts/acceptance-phase3.ts",
    "render:run": "tsx packages/renderer/scripts/render.ts",
    "acceptance:phase4": "tsx packages/renderer/scripts/acceptance-phase4.ts"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@effect/platform-node": "4.0.5",
    "@effect/vitest": "4.0.5",
    "@types/node": "22.20.5",
    "effect": "4.0.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
