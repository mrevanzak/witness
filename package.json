{
  "name": "ai-change-verifier",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "image:build": "docker build -t acv-computer:dev infra/computer",
