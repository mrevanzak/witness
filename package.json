{
  "name": "witness",
  "private": true,
  "type": "module",
  "scripts": {
    "acceptance:phase3": "tsx packages/orchestrator/scripts/acceptance-phase3.ts",
    "acceptance:phase4": "tsx packages/renderer/scripts/acceptance-phase4.ts",
    "build:control": "esbuild packages/computer/src/server/main.ts --bundle --platform=node --format=esm --target=node22 --external:playwright-core --log-level=warning --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=infra/computer/control/dist/control.mjs",
    "check": "ultracite check",
    "e2e:scripted": "tsx packages/orchestrator/scripts/scripted-e2e.ts",
    "fix": "ultracite fix",
    "image:build": "pnpm build:control && docker build -t witness-computer:dev infra/computer",
    "prepare": "husky",
    "render:run": "tsx packages/renderer/scripts/render.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/renderer/remotion/tsconfig.json && tsc -p apps/web/tsconfig.json --noEmit",
    "web:deploy": "pnpm --filter @witness/web run deploy",
    "web:destroy": "pnpm --filter @witness/web run destroy",
    "web:dev": "pnpm --filter @witness/web run dev",
    "web:plan": "pnpm --filter @witness/web run plan",
    "witness": "tsx apps/cli/src/main.ts",
    "witness:smoke": "tsx packages/computer/scripts/smoke.ts"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,json,jsonc,css,html}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@effect/language-service": "0.87.5",
    "@effect/platform-node": "4.0.5",
    "@effect/vitest": "4.0.5",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "effect": "4.0.5",
    "esbuild": "0.25.10",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "ultracite": "8.0.1",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22.18"
  }
}
