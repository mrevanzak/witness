# Copy to .env (gitignored). Alchemy reads it on dev and deploy.

# Bearer token the CLI uploads with. Use the same value for WITNESS_UPLOAD_TOKEN
# wherever you run `witness upload`. Generate one: openssl rand -hex 32
WITNESS_UPLOAD_TOKEN=

# Optional custom domain for report links (the zone must be in your Cloudflare account).
# Leave empty to use the workers.dev URL.
# WITNESS_DOMAIN=reports.example.com
