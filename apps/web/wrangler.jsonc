{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "witness-reports",
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "witness-reports" }],
	"d1_databases": [{ "binding": "DB", "database_name": "witness", "database_id": "local", "migrations_dir": "migrations" }],
	"observability": { "enabled": true }
	// Secret: UPLOAD_TOKEN (`wrangler secret put UPLOAD_TOKEN`; locally in .dev.vars)
}
