{
  "name": "@mrevanzak/witness",
  "version": "1.0.0",
  "description": "Independent, recorded QA for code changes: boots the app in a fresh Linux desktop, checks the change, and hands back a verdict, stills and video",
  "keywords": [
    "qa",
    "testing",
    "pull-request",
    "playwright",
    "screen-recording",
    "ai-agents"
  ],
  "homepage": "https://github.com/mrevanzak/witness#readme",
  "bugs": "https://github.com/mrevanzak/witness/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrevanzak/witness.git",
    "directory": "apps/cli"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "witness": "./dist/bin/witness.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "prepack": "npm run build",
    "postversion": "git commit -m \"chore(release): v$npm_package_version\" package.json && git tag v$npm_package_version"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@effect/platform-node": "4.0.5",
    "@remotion/bundler": "4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "dockerode": "4.0.12",
    "effect": "4.0.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.532",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@witness/computer": "workspace:*",
    "@witness/domain": "workspace:*",
    "@witness/orchestrator": "workspace:*",
    "@witness/renderer": "workspace:*",
    "esbuild": "0.25.10",
    "tsx": "4.23.15"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
